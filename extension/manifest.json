{
  "manifest_version": 3,
  "name": "Instagram Likes Cleanup",
  "version": "1.0.2",
  "description": "On-demand Likes cleanup with verified batches and recovery after a 20-second loading stall.",
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/your_activity/interactions/likes/*"
      ],
      "js": [
        "cleanup.js",
        "drag.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Instagram Likes Cleanup",
    "default_popup": "popup.html"
  }
}
